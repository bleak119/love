/**app.wxss**/

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
}

.container {
  padding: 20rpx;
}

/* Text styles */
.text-primary {
  color: #333;
  font-size: 32rpx;
  font-weight: bold;
}

.text-secondary {
  color: #666;
  font-size: 28rpx;
}

.text-tertiary {
  color: #999;
  font-size: 24rpx;
}

/* Button styles */
.btn {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
  cursor: pointer;
  border: none;
  transition: all 0.3s ease;
}

.btn-primary {
  background-color: #ff0000;
  color: white;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
}

.btn-secondary:active {
  background-color: #e0e0e0;
}

/* Card styles */
.card {
  background-color: white;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.card:active {
  background-color: #f9f9f9;
}

/* Flex utilities */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* Spacing utilities */
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }

/* Loading and empty states */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 100rpx 20rpx;
  color: #999;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

/* Divider */
.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 20rpx 0;
}
