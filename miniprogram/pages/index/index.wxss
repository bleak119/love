/* pages/index/index.wxss */

.index-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.search-container {
  padding: 10rpx 20rpx;
  background-color: white;
  border-bottom: 1rpx solid #eee;
}

.search-input {
  width: 100%;
  height: 70rpx;
  background-color: #f0f0f0;
  border-radius: 35rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}

.search-input::placeholder {
  color: #999;
}

.tab-container {
  display: flex;
  background-color: white;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #ff0000;
  border-bottom-color: #ff0000;
}

.music-list {
  flex: 1;
  overflow-y: auto;
}

.music-item {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background-color: white;
  border-bottom: 1rpx solid #eee;
  transition: background-color 0.2s ease;
}

.music-item:active {
  background-color: #f9f9f9;
}

.music-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.music-cover image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.music-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.music-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.music-artist {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.music-actions {
  margin-left: 10rpx;
  flex-shrink: 0;
}

.favorite-btn {
  background: none !important;
  border: none !important;
  padding: 10rpx;
  font-size: 32rpx;
  line-height: 1;
}

.favorite-btn.favorited {
  color: #ff0000;
}

.loading,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 20rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.no-more {
  text-align: center;
  color: #999;
  padding: 20rpx;
  font-size: 24rpx;
}
