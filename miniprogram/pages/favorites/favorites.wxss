/* pages/favorites/favorites.wxss */

.favorites-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: white;
  border-bottom: 1rpx solid #eee;
  position: relative;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  text-align: center;
}

.back-btn {
  background: none !important;
  border: none !important;
  font-size: 40rpx;
  color: #333;
  padding: 10rpx;
  line-height: 1;
  position: absolute;
  left: 20rpx;
}

.favorites-list {
  flex: 1;
  overflow-y: auto;
}

.favorite-item {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background-color: white;
  border-bottom: 1rpx solid #eee;
  transition: background-color 0.2s ease;
}

.favorite-item:active {
  background-color: #f9f9f9;
}

.item-number {
  font-size: 24rpx;
  color: #999;
  min-width: 40rpx;
  margin-right: 15rpx;
  text-align: center;
}

.item-info {
  flex: 1;
}

.item-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-artist {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-action {
  margin-left: 10rpx;
}

.remove-btn {
  background: none !important;
  border: none !important;
  font-size: 32rpx;
  color: #999;
  padding: 10rpx;
  line-height: 1;
}

.loading,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 20rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.discover-link {
  display: inline-block;
  padding: 15rpx 30rpx;
  background-color: #ff0000;
  color: white;
  border-radius: 8rpx;
  font-size: 28rpx;
}
