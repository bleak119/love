/* pages/login/login.wxss */

.login-container {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 20rpx;
}

.logo {
  margin-top: 100rpx;
  text-align: center;
}

.logo text {
  font-size: 72rpx;
  color: white;
  font-weight: bold;
}

.login-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  max-width: 500rpx;
}

.title {
  font-size: 48rpx;
  color: white;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  margin-bottom: 80rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background-color: #ff0000 !important;
  color: white;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.login-btn:active {
  opacity: 0.8;
}

.terms {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  margin-top: auto;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.terms navigator {
  color: white;
  text-decoration: underline;
}
