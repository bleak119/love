/* pages/my/my.wxss */

.my-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 100rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.openid {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.menu-container {
  flex: 1;
  margin-top: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin: 10rpx 0;
  background-color: white;
  border-bottom: 1rpx solid #eee;
  transition: background-color 0.2s ease;
}

.menu-item:active {
  background-color: #f9f9f9;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  color: #999;
  font-size: 32rpx;
}

.button-container {
  padding: 20rpx;
  background-color: white;
  border-top: 1rpx solid #eee;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background-color: #ff0000 !important;
  color: white;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn:active {
  opacity: 0.8;
}
