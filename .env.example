# Love Music Platform - Environment Configuration Example
# Copy this file to .env and fill in actual values
# DO NOT commit .env to version control

# WeChat Mini Program Configuration
WECHAT_APPID=your_wechat_appid_here
WECHAT_APPSECRET=your_wechat_appsecret_here

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-change-in-production

# MySQL Configuration
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=love_music
MYSQL_USER=love_user
MYSQL_PASSWORD=love_password_change_me

# Redis Configuration
REDIS_PASSWORD=redis_password_change_me

# Server Configuration
SERVER_PORT=8080
SERVER_DOMAIN=your-domain.com

# API Configuration
API_UPLOAD_MAX_FILE_SIZE=104857600
API_ALLOWED_FILE_TYPES=mp3,flac,wav

# Storage Configuration (choose one)
STORAGE_TYPE=local
# STORAGE_TYPE=oss
# OSS_ENDPOINT=your-oss-endpoint
# OSS_ACCESS_KEY_ID=your-access-key
# OSS_ACCESS_KEY_SECRET=your-secret-key
# OSS_BUCKET=your-bucket

# Email Configuration (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Logging Configuration
LOG_LEVEL=INFO
LOG_PATH=/app/logs
